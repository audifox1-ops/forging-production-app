# Supabase runtime configuration
# Copy this file to .env.local and replace the placeholders with your Supabase project values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# After setting real values, run:
# npm.cmd run verify:supabase
#
# If these values are missing, the app falls back to localStorage mode.
