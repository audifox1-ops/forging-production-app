# 데이터 이관용 키 — 이 파일을 복사해 .env.migration 으로 만들고 값을 채우세요.
# service_role 키는 Supabase Dashboard → Settings → API → service_role 에서 복사.
# ⚠️ service_role 키는 만능 키입니다. 이관이 끝나면 .env.migration 파일을 삭제하세요.
# (.env.migration은 .gitignore에 등록되어 커밋되지 않습니다)

# 구(현재 생산일보가 쓰는) 프로젝트
OLD_SUPABASE_URL=https://xxxxxxxx.supabase.co
OLD_SERVICE_ROLE_KEY=

# 새(Forging Insight) 프로젝트
NEW_SUPABASE_URL=https://yyyyyyyy.supabase.co
NEW_SERVICE_ROLE_KEY=
